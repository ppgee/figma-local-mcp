{
  "name": "figma-local-mcp",
  "version": "0.2.1",
  "description": "Read Figma Desktop designs through a local MCP bridge.",
  "packageManager": "pnpm@9.15.9",
  "private": true,
  "type": "module",
  "bin": {
    "figma-local-mcp": "dist/server/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/server/index.js",
    "install:local": "pnpm build && node scripts/install.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.142.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "license": "MIT"
}
